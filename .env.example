# Optional overrides, for development only: release builds ignore .env.
# Copy to .env in this source folder (the one with Cargo.toml): development
# builds read it from here, never from the folder they're started in. Only
# TM_* keys are read.

# Where your accounts, settings and mail cache are kept: a full path.
# Default: the platform's app data directory (see `tuimail --help`).
# TM_DATA_DIR=/Users/you/tm-test

# Which icons: auto, nerd (Nerd Font) or plain.
# TM_ICONS=plain
